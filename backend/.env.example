NODE_ENV=development
PORT=3000
FRONTEND_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hosis
# API_HOST=127.0.0.1
# To serve frontend/dist and the API over HTTPS, configure both files.
# HOSIS_TLS_CERT=/path/to/certificate.pem
# HOSIS_TLS_KEY=/path/to/private-key.pem
JWT_SECRET=replace-this-with-a-long-random-secret-before-running
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
DB_TIME_ZONE=Asia/Manila

# Update an existing Front Office account with npm run user:sync-front-office
FRONT_OFFICE_USERNAME=nath
FRONT_OFFICE_PASSWORD=
